<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="ur5_robotiq">

  <!-- ========================================================= -->
  <!-- 1. Includes                                               -->
  <!-- ========================================================= -->

  <xacro:include filename="$(find ur_description)/urdf/ur_macro.xacro"/>

  <xacro:include
      filename="$(find robotiq_description)/urdf/ur_to_robotiq_adapter.urdf.xacro"/>

  <xacro:include
      filename="$(find robotiq_description)/urdf/robotiq_2f_85_macro.urdf.xacro"/>


  <!-- ========================================================= -->
  <!-- 2. Base placeholder                                       -->
  <!-- ========================================================= -->

  <link name="base_link_parent"/>


  <!-- ========================================================= -->
  <!-- 3. UR5 arm                                                -->
  <!-- ========================================================= -->

  <xacro:ur_robot
      name="ur"
      tf_prefix=""
      parent="base_link_parent"
      joint_limits_parameters_file="$(find ur_description)/config/ur5/joint_limits.yaml"
      kinematics_parameters_file="$(find ur_description)/config/ur5/default_kinematics.yaml"
      physical_parameters_file="$(find ur_description)/config/ur5/physical_parameters.yaml"
      visual_parameters_file="$(find ur_description)/config/ur5/visual_parameters.yaml"
      safety_limits="false"
      safety_pos_margin="0.15"
      safety_k_position="20"
      force_abs_paths="true">

    <origin xyz="0 0 0" rpy="0 0 0"/>

  </xacro:ur_robot>


  <!-- ========================================================= -->
  <!-- 4. UR tool flange -> Robotiq adapter                      -->
  <!-- ========================================================= -->

  <xacro:ur_to_robotiq
      prefix=""
      parent="tool0"
      child="robotiq_gripper_mount"
      rotation="0.0"/>


  <!-- ========================================================= -->
  <!-- 5. Robotiq 2F-85                                          -->
  <!-- ========================================================= -->

  <xacro:robotiq_gripper
      name="robotiq_gripper"
      prefix=""
      parent="robotiq_gripper_mount"
      sim_gazebo="false"
      include_ros2_control="false">

    <origin xyz="0 0 0" rpy="0 0 0"/>

  </xacro:robotiq_gripper>


  <!-- ========================================================= -->
  <!-- 6. TCP                                                    -->
  <!-- ========================================================= -->

  <!-- Provisional TCP: adjust its pose to the actual gripper geometry. -->
  <link name="tool0_tcp"/>

  <joint name="robotiq_base_to_tcp" type="fixed">
    <parent link="robotiq_85_base_link"/>
    <child link="tool0_tcp"/>
    <origin xyz="0 0 0.15" rpy="0 0 0"/>
  </joint>

</robot>